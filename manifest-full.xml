<?xml version="1.0" encoding="UTF-8"?>
<!-- Liquid Habits full tracker, shown as a box on a worksheet (content add-in). Hosted on GitHub Pages. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>9b2e7d41-5c3a-4f8e-b6a1-7e2d3c4b5a69</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Liquid Habits</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Liquid Habits Full"/>
  <Description DefaultValue="The whole liquid-glass habit tracker on a worksheet, reading and writing Habit Tracker.xlsm."/>
  <IconUrl DefaultValue="https://jinkailee.github.io/liquid-habits-panel/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://jinkailee.github.io/liquid-habits-panel/icon-80.png"/>
  <SupportUrl DefaultValue="https://jinkailee.github.io/liquid-habits-panel/full.html"/>
  <Hosts><Host Name="Workbook"/></Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://jinkailee.github.io/liquid-habits-panel/full.html"/>
    <RequestedWidth>1000</RequestedWidth>
    <RequestedHeight>700</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
